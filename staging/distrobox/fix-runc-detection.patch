From 031f72c8570b3e5aeefa794fbc915937e100f6b7 Mon Sep 17 00:00:00 2001
From: Lauro <lauro@dilorenzo.one>
Date: Tue, 17 Nov 2026 07:36:49 +0100
Subject: [PATCH] fix: detect runc by OCI runtime name only

---
 distrobox-create | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/distrobox-create b/distrobox-create
index 57e0ca2a20..a1a2b3570d 100755
--- a/distrobox-create
+++ b/distrobox-create
@@ -740,7 +740,10 @@ generate_create_command()
 	# This will ensure we will mount directories one-by-one thus avoiding this problem.
 	#
 	# This happens ONLY with podman+runc, docker and lilipod are unaffected, so let's do this only if we have podman AND runc.
-	if echo "${container_manager}" | grep -q "podman" && ${container_manager} info 2> /dev/null | grep -q runc > /dev/null 2>&1; then
+	# Check only the runtime name: since Podman 6.2 the full "podman info" output embeds the runtime's
+	# features JSON, and crun's features mention "org.opencontainers.runc.checkpoint.enabled".
+	if echo "${container_manager}" | grep -q "podman" &&
+		${container_manager} info --format '{{.Host.OCIRuntime.Name}}' 2> /dev/null | grep -q runc > /dev/null 2>&1; then
 		for rootdir in /*; do
 
 			# Skip symlinks
